---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	planner(planner)
	writer(writer)
	reviewer(reviewer)
	finaliser(finaliser)
	__end__([<p>__end__</p>]):::last
	__start__ --> planner;
	planner --> writer;
	reviewer -.-> finaliser;
	reviewer -.-> writer;
	writer --> reviewer;
	finaliser --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
